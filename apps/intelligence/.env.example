# Muse Intelligence
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only key for future privileged application operations. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie behavior. Production should leave this unset and use ENVIRONMENT=production.
MUSE_COOKIE_SECURE=

MUSE_CORS_ORIGINS=http://localhost:5173
MUSE_DATABASE_PATH=./data/muse.sqlite3
