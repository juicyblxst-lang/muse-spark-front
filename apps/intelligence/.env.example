# Muse API
APP_NAME=Muse API
API_VERSION=v1
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY - never expose this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Sibyl / persistent storage
SIBYL_DB_PATH=./data/sibyl/muse.sqlite3
STORAGE_BUCKET=muse-documents
STORAGE_ROOT=./data

# LLM - server only
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# OpenClaw - server only
OPENCLAW_BASE_URL=
OPENCLAW_API_KEY=

# Processing limits
MAX_UPLOAD_BYTES=52428800
MAX_PROCESSING_ATTEMPTS=3
PROCESSING_TIMEOUT_SECONDS=900
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
