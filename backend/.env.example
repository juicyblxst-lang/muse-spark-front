# Muse API
APP_NAME=Muse API
API_VERSION=v1

# Persistent Sibyl SQLite database.
# Local development: mount/use ./data/sibyl
# Production: point this at a persistent disk/volume, never ephemeral container storage.
SIBYL_DB_PATH=./data/sibyl/muse.sqlite3

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
